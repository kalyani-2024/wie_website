---
import { Image } from 'astro:assets';
import wieLogo from '../assets/wie-logo.png';
import { nav, type NavLabel } from '../site';

interface Props {
  /** Current page — coloured #D8A7F0 in the nav. Omitted on Home. */
  current?: NavLabel;
  /** Home lays the header over the hero photo; subpages get a flat bar. */
  variant?: 'solid' | 'hero';
}

const { current, variant = 'solid' } = Astro.props;
---

<header class:list={['site-head', `site-head--${variant}`]}>
  <a class="brand" href="/">
    <Image src={wieLogo} alt="IEEE WIE BPDC" width={92} densities={[1, 2]} />
    <span class="brand-copy">
      <strong><b>W</b><b>I</b><b>E</b> BPDC</strong>
      <small>Women In Engineering</small>
    </span>
  </a>
  <nav class="nav" aria-label="Primary">
    {
      nav.map((item) => (
        <a href={item.href} aria-current={item.label === current ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
