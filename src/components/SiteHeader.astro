---
import { Image } from 'astro:assets';
import wieLogo from '../assets/wie-logo.png';
import { nav, type NavLabel } from '../site';

interface Props {
  /** Current page — coloured #D8A7F0 in the nav. Omitted on Home. */
  current?: NavLabel;
  /** Home lays the header over the hero photo; subpages get a flat bar. */
  variant?: 'solid' | 'hero';
}

const { current, variant = 'solid' } = Astro.props;
---

<header class:list={['site-head', `site-head--${variant}`]}>
  <a class="brand" href="/">
    <span class="brand-mark">
      <Image src={wieLogo} alt="IEEE WIE BPDC" width={92} height={92} densities={[1, 2]} />
    </span>
    <span class="brand-copy">
      <strong><b>W</b><b>I</b><b>E</b> BPDC</strong>
      <small>Women In Engineering</small>
    </span>
  </a>
  <nav class="nav" aria-label="Primary">
    {
      nav.map((item) => (
        <a href={item.href} aria-current={item.label === current ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .brand-mark {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 68px;
    height: 68px;
  }

  .brand-mark::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #ffffff;
    z-index: 0;
  }

  .brand-mark :global(img) {
    position: relative;
    z-index: 1;
    width: 52px;
    height: 52px;
    object-fit: contain;
  }
</style>