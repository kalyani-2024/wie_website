---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photo: ImageMetadata;
  /** Home runs 118px, Gallery 96px, the rest 104px. */
  size?: 'home' | 'gallery' | 'default';
  narrow?: boolean;
}

const { photo, size = 'default', narrow = false } = Astro.props;
---

<section
  class:list={[
    'cta-band',
    { 'cta-band--home': size === 'home', 'cta-band--gallery': size === 'gallery' },
  ]}
>
  <Image
    src={photo}
    alt=""
    widths={[900, 1400, 1920]}
    sizes="100vw"
    class="fill"
    style="position: absolute; inset: 0; object-fit: cover;"
  />
  <div class="duo-color duo-color--cta"></div>
  <div class="duo-flat"></div>
  <div class:list={['cta-inner', { 'cta-inner--narrow': narrow }]}>
    <slot />
  </div>
</section>
