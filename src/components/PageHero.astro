---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Background photograph for the band. */
  photo: ImageMetadata;
  eyebrow: string;
  /** Join's band is slightly taller. */
  tall?: boolean;
  /** Contact and Events run to 26ch. */
  wide?: boolean;
}

const { photo, eyebrow, tall = false, wide = false } = Astro.props;
---

<section class:list={['title-band', { 'title-band--tall': tall }, 'g-fade']}>
  <Image
    src={photo}
    alt=""
    widths={[900, 1400, 1920]}
    sizes="100vw"
    class="fill"
    style="position: absolute; inset: 0; object-fit: cover;"
  />
  <div class="duo-color"></div>
  <div class="duo-grad--title"></div>
  <div class="wrap">
    <p class="eyebrow-dark" set:html={eyebrow} />
    <h1 class:list={['h1-page', { 'h1-page--wide': wide }]}><slot /></h1>
    <slot name="below" />
  </div>
</section>
