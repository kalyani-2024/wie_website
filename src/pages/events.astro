---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHero from '../components/PageHero.astro';
import PosterCard from '../components/PosterCard.astro';

import escape2 from '../assets/photos/escape-2.jpg';
import resumeBuilding from '../assets/posters/resume-building.png'
import linkedinWorkshop from '../assets/posters/linkedin-workshop.png';
import breakingBad from '../assets/posters/breaking-bad.png';
import promptVerse from '../assets/posters/promptverse.png';
import breastCancer from '../assets/posters/breast-cancer-workshop.png';
import beyondTheDegree from '../assets/posters/beyond-the-degree.png';
import escapeRoom from '../assets/posters/escape-room.png';
import unsungHeroes from '../assets/posters/unsung-heroes.jpg';
import www from '../assets/posters/www.jpg';
import techTaboo from '../assets/posters/tech-taboo.png';
import lostCode from '../assets/posters/lost-code.jpg';
import btfXWie from '../assets/posters/btf-x-wie.png';

/* Model an event as title / kicker / description / poster, per the handoff —
   ready to move to a CMS or JSON feed without touching the markup. */
const pastEvents = [
  {
    poster: resumeBuilding,
    posterAlt: 'Resume Building Poster',
    kicker: 'Workshop · Feb 2026',
    title: 'Resume Building',
    description:
      'Learning how to create a standout resume that actually gets noticed by employers.',
  },
  {
    poster: linkedinWorkshop,
    posterAlt: 'Linkedin Workshop Poster',
    kicker: 'Workshop · Feb 2026',
    title: 'LinkedIn 101',
    description:
      'Learning how to optimize your LinkedIn profile and network effectively.',
  },
  {
    poster: breakingBad,
    posterAlt: 'Breaking Bad Poster',
    kicker: 'Online Event · Dec 2025',
    title: 'Breaking Bad',
    description:
      'Breaking Bad-inspired chemistry quiz featuring fun MCQs and True/False questions through Instagram story polls.',
  },
  {
    poster: lostCode,
    posterAlt: 'The Lost Code poster',
    kicker: 'Collaboration · Dec 2025',
    title: 'The Lost Code',
    description: 'A joint event with IEI, The Lost Code was a bioinformatics competition where participants used BLAST to identify genetic homologues.',
  },
  {
    poster: btfXWie,
    posterAlt: 'BTF x WIE poster',
    kicker: 'Outreach · Nov 2025',
    title: 'BTF × WIE',
    description:
      'A collaborative outreach drive taking engineering beyond campus, the stall explored Human, Traditional AI, and Agentic AI through interactive games.',
  },
  {
    poster: promptVerse,
    posterAlt: 'BTF x WIE poster',
    kicker: 'Workshop · Nov 2025',
    title: 'Promptverse',
    description:
      'A hands-on workshop introducing participants to Generative AI, covering LLMs, diffusion models, prompt engineering, and creative applications.',
  },
  {
    poster: beyondTheDegree,
    posterAlt: 'Beyond the Degree poster',
    kicker: 'Industry · Oct 2025',
    title: 'Beyond the Degree',
    description:
      'Turning classroom knowledge into career confidence, with TÜV Rheinland engineers.',
  },
  {
    poster: breastCancer,
    posterAlt: 'Breast Cancer Awareness Poster',
    kicker: 'Collaboration · Oct 2025',
    title: 'Breast Cancer Awareness',
    description:
      'A collaborative workshop with SWE combining breast cancer awareness with applications of data science and machine learning in healthcare.',
  },
  {
    poster: escapeRoom,
    posterAlt: 'The Final Experiment poster',
    kicker: 'Competition · Sep 2025',
    title: 'The Final Experiment',
    description: 'An escape room quest; one missing scientist, teams of two to three.',
  },
  {
    poster: techTaboo,
    posterAlt: 'Tech Taboo poster',
    kicker: 'Competition · Sep 2025',
    title: 'Tech Taboo',
    description: 'A fun challenge where participants played a guessing game with engineering terms.',
  },
  {
    poster: www,
    posterAlt: 'WWW Poster',
    kicker: 'Competition · Sep 2025',
    title: 'WWW',
    description: 'A four-week online Instagram quiz series featuring fun “2 Truths & 1 Lie” challenges about inspiring women in STEM.',
  },
  {
    poster: unsungHeroes,
    posterAlt: 'Unsung HERoes campaign poster',
    kicker: 'Campaign · Aug 2025',
    title: 'Unsung HERoes',
    description: 'The women of STEM history the syllabus leaves out, one story a day.',
  },
];

---

<Base
  title="Events — IEEE WIE BPDC"
  description="Every workshop, competition, campaign and outreach drive run by the IEEE WIE chapter at BITS Pilani, Dubai Campus."
>
  <SiteHeader current="Events" />

  <main id="main" class="events-page">
    <PageHero photo={escape2} eyebrow="Our Events" wide>
      Everything we have run, on the record.
    </PageHero>

    <section class="section wrap" style="padding-block: 84px 92px;">
      <h2 class="h2 h2--sm h2-rule force-36" style="margin-bottom: 40px;">Past events</h2>
      <div class="grid-3" style="gap: 32px 24px; align-items: start;">
        {pastEvents.map((event) => <PosterCard {...event} />)}
      </div>
    </section>

  </main>

  <SiteFooter />
</Base>

<style>
  main.events-page :global(.eyebrow-dark) {
    font-size: 24px;
    letter-spacing: 0.18em;
    line-height: 1.2;
  }

  main.events-page :global(.h1-page) {
    font-size: clamp(52px, 7vw, 118px);
  }

  main.events-page :global(.h2) {
    font-size: clamp(38px, 4.8vw, 68px);
  }

  main.events-page :global(.card-kicker) {
    font-size: 12px;
    letter-spacing: 0.22em;
  }

  main.events-page :global(.card-title) {
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.08;
  }

  main.events-page :global(.card-desc) {
    font-size: 17px;
    line-height: 1.6;
  }

  main.events-page :global(.panel--event h3) {
    font-size: clamp(30px, 3vw, 42px) !important;
    line-height: 1.08;
  }

  main.events-page :global(.panel--event .body-sm) {
    font-size: 17px !important;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .two-up {
      grid-template-columns: 1fr !important;
    }
  }
</style>
