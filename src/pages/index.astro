---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CtaBand from '../components/CtaBand.astro';
import PosterCard from '../components/PosterCard.astro';
import { FORM_URL, placeholders } from '../site';

import genai1 from '../assets/photos/genai-1.jpg';
import genai2 from '../assets/photos/genai-2.jpg';
import genai3 from '../assets/photos/genai-3.jpg';
import escape1 from '../assets/photos/escape-1.jpg';
import escape3 from '../assets/photos/escape-3.jpg';
import btf1 from '../assets/photos/btf-1.jpg';
import btf2 from '../assets/photos/btf-2.jpg';
import btf3 from '../assets/photos/btf-3.jpg';
import labSession from '../assets/photos/lab-session.png';
import teamSession1 from '../assets/photos/team-session-1.jpg';
import unsungHeroes1 from '../assets/photos/unsung-heroes-1.jpg';
import escapeClues1 from '../assets/photos/escape-clues-1.jpg';
import school1 from '../assets/photos/school-outreach-1.jpg';

import beyondTheDegree from '../assets/posters/beyond-the-degree.png';
import linkedinWorkshop from '../assets/posters/linkedin-workshop.png';
import breakingBad from '../assets/posters/breaking-bad.png';
import promptverse from '../assets/posters/promptverse.png';
import breastCancer from '../assets/posters/breast-cancer-workshop.png';
import www from '../assets/posters/www.jpg';
import escapeRoom from '../assets/posters/escape-room.png';
import resumeBuilding from '../assets/posters/resume-building.png';
import unsungHeroes from '../assets/posters/unsung-heroes.jpg';

/* One 26s loop, each frame offset by -6.5s, so exactly one photo is at
   full opacity at a time and its caption changes with it. */
const slides = [
  {
    photo: genai3,
    alt: 'Members at the Promptverse Gen AI workshop',
    delay: '0s',
  },
  {
    photo: escapeClues1,
    alt: 'Solving clues at The Final Experiment escape room',
    delay: '-20.8s',
  },
  {
    photo: school1,
    alt: 'School Outreach',
    delay: '-15.6s',
  },
  {
    photo: unsungHeroes1,
    alt: 'School students at the Unsung Heroes outreach booth',
    delay: '-10.4s',
  },
  {
    photo: teamSession1,
    alt: 'Core team working together on a chapter session',
    delay: '-5.2s',
  },
];

const stats = [
  { value: placeholders.members, label: 'Members' },
  { value: placeholders.eventsRun, label: 'Events run' },
  { value: placeholders.activities, label: 'Years active' },
  { value: placeholders.founded, label: 'Founded' },
];

const events = [
  {
    poster: promptverse,
    posterAlt: 'Promptverse workshop poster',
    kicker: 'WORKSHOP · NOV 2025',
    title: 'Promptverse: Gen AI workshop',
    description:
      'Exploring the fundamentals of Generative AI, its capabilities, and its real-world applications.',
  },

  {
    poster: escapeRoom,
    posterAlt: 'The Final Experiment poster',
    kicker: 'Competition · Sep 2025',
    title: 'The Final Experiment',
    description: 'An escape room quest, teams of two to three.',
  },
  {
    poster: resumeBuilding,
    posterAlt: 'Resume Building Workshop poster',
    kicker: 'WORKSHOP · NOV 2025',
    title: 'Resume Building Workshop',
    description:
      'Focused on the key elements of building a strong, professional, and effective resume.',
  },

];
---

<Base
  title="IEEE WIE BPDC — Women in Engineering, BITS Pilani Dubai Campus"
  description="The IEEE Women in Engineering student chapter at BITS Pilani, Dubai Campus: workshops, competitions, industry rooms and outreach, open to every student on campus."
>
  <section class="hero">
    <div class="band-media">
      {
        slides.map((slide) => (
          <Image
            src={slide.photo}
            alt={slide.alt}
            widths={[900, 1400, 1920, 2400]}
            sizes="100vw"
            class="hero-slide"
            style={`--delay: ${slide.delay};`}
          />
        ))
      }
      <div class="duo-color"></div>
      <div class="duo-grad--hero"></div>
    </div>

    <SiteHeader variant="hero" />

    <div class="hero-copy" id="main">
      <h1 class="h1-hero hero-title">
        <span class="hero-line"><span class="hero-line__in"><em>Women</em> Build.</span></span>
        <span class="hero-line"><span class="hero-line__in"><em>Women</em> Lead.</span></span>
        <span class="hero-line"><span class="hero-line__in"><em>Women</em> Empower.</span></span>
      </h1>
      <p class="lead-dark">
        A student chapter creating opportunities through hands-on projects, competitions,
        and industry connections, while welcoming students from across campus.
      </p>
      <div style="display: flex; gap: 34px; align-items: center; margin-top: 40px; flex-wrap: wrap;">
        <a class="btn-light btn-light--hero" href="/join/">JOIN US</a>
        <a class="link-ul-dark" href="/events/">See our events</a>
      </div>
    </div>

    <div class="hero-foot">
      <div class="stats">
        {
          stats.map((stat, i) => (
            <div class="stat" style={`--stat-i: ${i};`}>
              <p class="stat-value" data-count={stat.value}>
                {stat.value}
              </p>
              <p class="stat-label">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="two-col wrap" style="padding: 108px var(--gutter); align-items: start;">
    <div>
      <p class="eyebrow eyebrow--mission">Why we exist</p>
      <p class="lead mission-copy">
        Our chapter creates opportunities to learn beyond the classroom, connect with mentors
        and peers, and turn ideas into meaningful work. We aim to build a strong community
        that grows with every new generation of women in engineering.
      </p>
      <a class="link-ul" href="/about/" style="margin-top: 30px;">Read our mission →</a>
    </div>
    <div class="photo-grid">
      <Image src={escape3} alt="Escape room event" widths={[400, 640, 900]} sizes="(max-width: 860px) 45vw, 25vw" />
      <Image src={btf2} alt="Outreach drive" widths={[400, 640, 900]} sizes="(max-width: 860px) 45vw, 25vw" />
      <Image src={genai2} alt="Workshop session" widths={[400, 640, 900]} sizes="(max-width: 860px) 45vw, 25vw" />
      <Image src={labSession} alt="Members working together in a workshop" widths={[400, 640, 900]} sizes="(max-width: 860px) 45vw, 25vw" />
    </div>
  </section>

  <section class="section section--ruled" style="padding-block: 92px;">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2 h2--lg force-36">Our Events</h2>
        <a class="link-plum" href="/events/">Full archive →</a>
      </div>
      <div class="grid-3" style="align-items: start;">
        {events.map((event) => <PosterCard {...event} />)}
      </div>
    </div>
  </section>

  <CtaBand photo={btf1} size="home">
    <h2 class="h2-dark">Membership is open to every student on campus.</h2>
    <p
      class="lead-dark"
      style="margin: 22px auto 34px; max-width: none; font-size: 17px; line-height: 1.65;"
    >
      One form, and you are on the list for everything we run this semester.
    </p>
    <a class="btn-light" href={FORM_URL}>Membership form →</a>
  </CtaBand>

  <SiteFooter />
</Base>

<style>
  /* The three "Women ..." lines are the whole band now — no kicker above
     them — so they are sized to hold each line on one line at every width. */
  .hero-title {
    font-size: clamp(42px, 6.2vw, 92px);
    line-height: 0.88;
    letter-spacing: -0.028em;
  }

  /* "Women" recedes a step so the verb reads as the beat of each line. */
  .hero-title em {
    font-style: normal;
    color: rgba(242, 233, 247, 0.62);
  }

  /* The mask is the line box, so it has to be padded out past the cap
     height and the descender of "Empower." — then pulled back in with an
     equal negative margin so the leading is unchanged. */
  .hero-line {
    display: block;
    overflow: hidden;
    padding: 0.08em 0 0.16em;
    margin: -0.08em 0 -0.16em;
  }

  .hero-line__in {
    display: block;
    transform: translateY(105%);
    animation: heroLine 1.05s cubic-bezier(0.16, 0.84, 0.3, 1) forwards;
  }

  .hero-line:nth-child(1) .hero-line__in {
    animation-delay: 0.18s;
  }
  .hero-line:nth-child(2) .hero-line__in {
    animation-delay: 0.32s;
  }
  .hero-line:nth-child(3) .hero-line__in {
    animation-delay: 0.46s;
  }

  @keyframes heroLine {
    to {
      transform: translateY(0);
    }
  }

  /* Stats rise in one at a time once the foot of the hero is on screen. */
  .stat {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.7s cubic-bezier(0.16, 0.84, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 0.84, 0.3, 1);
    transition-delay: calc(var(--stat-i, 0) * 90ms);
  }

  .stats.is-in .stat {
    opacity: 1;
    transform: none;
  }

  .stat-value {
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line__in {
      transform: none;
      animation: none;
    }

    .stat {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  /* Stats: reveal the row and roll each number up from zero, once. */
  const statsRow = document.querySelector<HTMLElement>('.hero-foot .stats');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (statsRow && !reduced) {
    const values = Array.from(statsRow.querySelectorAll<HTMLElement>('.stat-value'));

    /* "100+" -> ["100", "+"]; "2021" -> ["2021", ""]. Anything without a
       leading number is left exactly as authored. */
    const parse = (raw: string) => {
      const match = raw.match(/^(\d+)(.*)$/);
      return match ? { target: Number(match[1]), suffix: match[2] } : null;
    };

    const countUp = (el: HTMLElement, target: number, suffix: string) => {
      const duration = 1100;
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = Math.round(target * eased) + suffix;
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    values.forEach((el) => {
      const parsed = parse(el.dataset.count ?? el.textContent ?? '');
      if (parsed) el.textContent = '0' + parsed.suffix;
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          observer.disconnect();
          statsRow.classList.add('is-in');
          values.forEach((el, i) => {
            const parsed = parse(el.dataset.count ?? '');
            if (!parsed) return;
            setTimeout(() => countUp(el, parsed.target, parsed.suffix), 90 * i);
          });
        });
      },
      { threshold: 0.4 }
    );

    observer.observe(statsRow);
  } else if (statsRow) {
    statsRow.classList.add('is-in');
  }
</script>
