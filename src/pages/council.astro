---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHero from '../components/PageHero.astro';

import genai3 from '../assets/photos/genai-3.jpg';
import wieMark from '../assets/wie-mark.png';
import vaniaRoy from '../assets/vania-roy.png';
import shreiyaRamaswamy from '../assets/shreiya-ramaswamy.png';
import jeanneFranklin from '../assets/jeanne-franklin.png';
import mahimaShivraj from '../assets/mahima-shivraj.png';
import briannaJoan from '../assets/brianna-joan.png';
import maheenMallik from '../assets/maheen-mallik.png';
import dhanviJigneshShah from '../assets/dhanvi-jignesh-shah.png';
import jessicaMarianaJohn from '../assets/jessica-mariana-john.png';
import nuhaShanawaz from '../assets/nuha-shanawaz.png';
import aarnaMunjal from '../assets/aarna-munjal.png';
import shriyaKhivasara from '../assets/shriya-khivasara.png';
import roshniRamkumar from '../assets/roshni-ramkumar.png';
import arushriGangji from '../assets/arushri-gangji.png';
import devyaniKachhwah from '../assets/devyani-kachhwah.png';
import juannElsaKuruvilla from '../assets/juann-elsa-kuruvilla.png';
import nisrita from '../assets/nisrita.png';
import sreelakshmiRajasekharanPotti from '../assets/sreelakshmi-rajasekharan-potti.png';
import suhaniSaikrishna from '../assets/suhani-saikrishna.png';
import avishiAggarwal from '../assets/avishi-aggarwal.png';
import ankithaSurisetty from '../assets/ankitha-surisetty.png';
import kalyaniBaiju from '../assets/kalyani-baiju.png';

const coreTeam = [
  { role: 'Chair', name: 'Vania Roy', photo: vaniaRoy },
  { role: 'Vice chair', name: 'Shreiya Ramaswamy', photo: shreiyaRamaswamy },
  { role: 'Secretary', name: 'Jeanne Franklin', photo: jeanneFranklin },
  { role: 'Treasurer', name: 'Suhani Saikrishna', photo: suhaniSaikrishna },
];

const leads = [
  { role: 'MARKETING LEAD', name: 'Mahima Shivraj', photo: mahimaShivraj },
  { role: 'Design lead', name: 'Brianna Joan', photo: briannaJoan },
  { role: 'Outreach lead', name: 'Ankitha Surisetty', photo: ankithaSurisetty },
  { role: 'Technical lead', name: 'Kalyani Baiju', photo: kalyaniBaiju },
  { role: 'EX-OFFICIO', name: 'Avishi Aggarwal', photo: avishiAggarwal },
];

const committee = [
  { name: 'Maheen Mallik', designation: 'Technical Coordinator', photo: maheenMallik },
  { name: 'Dhanvi Jignesh Shah', designation: 'Technical Coordinator', photo: dhanviJigneshShah },
  { name: 'Jessica Mariana John', designation: 'Logistics Coordinator', photo: jessicaMarianaJohn },
  { name: 'Nuha Shanawaz', designation: 'Outreach Coordinator', photo: nuhaShanawaz },
  { name: 'Aarna Munjal', designation: 'Outreach Coordinator', photo: aarnaMunjal },
  { name: 'Shriya Khivasara', designation: 'Outreach Coordinator', photo: shriyaKhivasara },
  { name: 'Roshni Ramkumar', designation: 'Marketing Coordinator', photo: roshniRamkumar },
  { name: 'Arushri Gangji', designation: 'Marketing Coordinator', photo: arushriGangji },
  { name: 'Devyani Kachhwah', designation: 'Marketing Coordinator', photo: devyaniKachhwah },
  { name: 'Juann Elsa Kuruvilla', designation: 'Design Coordinator', photo: juannElsaKuruvilla },
  { name: 'Nisrita', designation: 'Design Coordinator', photo: nisrita },
  { name: 'Sreelakshmi Rajasekharan Potti', designation: 'Design Coordinator', photo: sreelakshmiRajasekharanPotti },
];
---

<Base
  title="Council — IEEE WIE BPDC"
  description="The elected council of the IEEE Women in Engineering chapter at BITS Pilani, Dubai Campus."
>
  <SiteHeader current="Council" />

  <main id="main">
    <PageHero photo={genai3} eyebrow="The council">
      Who runs the chapter.
    </PageHero>

    <section class="section wrap" style="padding-block: 84px 0;">
      <p class="body" style="max-width: 60ch; margin-bottom: 40px;">
        The council is a student-led team that drives the club’s initiatives, events, and
        community throughout the academic year. New council members are selected annually to
        bring fresh ideas, leadership, and perspectives to the club.
      </p>
      <h2 class="h2 h2--xs h2-rule" style="margin-bottom: 30px;">Core team</h2>
      <div class="grid-4">
        {
          coreTeam.map((person) => (
            <article>
              <div class="portrait">
                <Image
                  src={person.photo ?? wieMark}
                  alt={person.name ? `${person.name} portrait` : 'Portrait placeholder'}
                  width={200}
                  densities={[1, 2]}
                  class:list={{ 'portrait-photo': Boolean(person.photo) }}
                />
              </div>
              <p class="person-name">{person.name ?? '[Name placeholder]'}</p>
              <p class="person-role">{person.role}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section wrap" style="padding-block: 64px 92px;">
      <h2 class="h2 h2--xs h2-rule" style="margin-bottom: 30px;">Leads</h2>
      <div class="grid-4">
        {
          leads.map((person) => (
            <article>
              <div class="portrait">
                <Image
                  src={person.photo ?? wieMark}
                  alt={person.name ? `${person.name} portrait` : 'Portrait placeholder'}
                  width={200}
                  densities={[1, 2]}
                  class:list={{ 'portrait-photo': Boolean(person.photo) }}
                />
              </div>
              <p class="person-name">{person.name ?? '[Name placeholder]'}</p>
              <p class="person-role" style="margin-bottom: 0;">
                {person.role}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section wrap" style="padding-block: 64px 92px;">
      <h2 class="h2 h2--xs h2-rule" style="margin-bottom: 30px;">Committee</h2>
      <div class="grid-4">
        {
          committee.map((person) => (
            <article>
              <div class="portrait">
                <Image
                  src={person.photo ?? wieMark}
                  alt={person.name ? `${person.name} portrait` : 'Committee member placeholder'}
                  width={200}
                  densities={[1, 2]}
                  class:list={{ 'portrait-photo': Boolean(person.photo) }}
                />
              </div>
              <p class="person-name">{person.name}</p>
              <p class="person-role" style="margin-bottom: 0;">{person.designation}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section section--ruled">
      <div class="wrap two-col">
        <div>
          <p class="eyebrow">Faculty advisor</p>
          <h2 class="h2" style="font-size: clamp(26px, 3.2vw, 42px); line-height: 1.14;">
            Dr. R. Swarnalatha, Ph.D.
          </h2>
          <p
            class="body"
            style="margin-top: 18px; font-size: 16.5px; line-height: 1.7; color: rgba(26,18,32,.74);"
          >
            Associate Dean, Admissions and Marketing<br />
            Associate Professor, Department of Electrical &amp; Electronics Engineering
          </p>
        </div>
        <div>
          <p class="eyebrow">Join the council</p>
          <p
            class="body"
            style="margin-bottom: 26px; font-size: 16.5px; line-height: 1.7; color: rgba(26,18,32,.74);"
          >
            Council positions open once each academic year and are filled from the active
            membership. Members are notified before applications open.
          </p>
          <a class="btn-outline" href="/join/">JOIN US →</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  /* Core team / Leads / Committee sit at a fixed 40px — the roster below
     each one is the content, so the heading only needs to label the block. */
  .h2--xs {
    font-size: 40px;
    line-height: 1.06;
  }
</style>
